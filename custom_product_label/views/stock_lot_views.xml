<odoo>
    <record id="stock_view_production_lot_tree_inherit" model="ir.ui.view">
        <field name="name">stock.view.production.lot.tree.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>

        <field name="arch" type="xml">
            <xpath expr="//tree/field" position="before">
                <header>
                    <button name="action_print_labels" type="object" class="btn-primary" string="Stampa Etichette"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>